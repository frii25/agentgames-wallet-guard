# Wallet Guard — local dev environment.
# Copy to .env (never commit .env; never paste real secrets into AI tools).
# On Vercel, set these in the project dashboard instead.

# HMAC secret shared with the Agent Games platform (from Rotate Secret in
# the dashboard). REQUIRED in production; without it the endpoint rejects
# every request unless ALLOW_UNSIGNED=true (local dev only).
AGENT_GAMES_HMAC_SECRET=

# Local dev only: accept unsigned requests when no secret is configured.
# Default false (strict). Never enable in production.
ALLOW_UNSIGNED=false

# BSC JSON-RPC endpoint(s), comma-separated for fallback. Public default:
# https://bsc-dataseed.binance.org/
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Per-RPC-call timeout in ms.
BSC_RPC_TIMEOUT_MS=8000

# How far back to scan Approval events, in blocks (~500k blocks ≈ 17 days).
GUARD_SCAN_BLOCKS=500000

# Max distinct (token, spender) pairs to resolve allowances for per wallet.
GUARD_MAX_PAIRS=100

# Internal assessment deadline in ms (must stay under the 60s platform limit).
GUARD_DEADLINE_MS=50000

# Optional extra high-risk spender addresses, comma-separated.
HIGH_RISK_SPENDERS=

# Local dev server port.
PORT=3000
